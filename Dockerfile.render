# ============================================================
# Tel-Agent - Render combined image
# API + Next.js Dashboard
# ============================================================

# -------------------------
# API BUILD
# -------------------------

FROM python:3.12-slim AS api-build

WORKDIR /app

COPY pyproject.toml README.md ./

RUN mkdir -p api agent

RUN pip install --no-cache-dir .

COPY api/ api/
COPY agent/ agent/
COPY locales/ locales/
COPY alembic/ alembic/
COPY alembic.ini ./
COPY scripts/ scripts/

RUN pip install --no-cache-dir --no-deps --force-reinstall .


# -------------------------
# WEB BUILD
# -------------------------

FROM node:22-alpine AS web-build

WORKDIR /repo

COPY web/package.json web/package-lock.json web/

RUN cd web && npm ci

COPY locales/ locales/
COPY web/ web/

RUN mkdir -p web/public

ARG NEXT_PUBLIC_API_URL

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NODE_ENV=production

RUN cd web && npm run build


# -------------------------
# FINAL IMAGE
# -------------------------

FROM python:3.12-slim

RUN useradd --create-home --uid 1000 telagent

WORKDIR /app

# Python environment
COPY --from=api-build /usr/local/lib/python3.12/site-packages \
    /usr/local/lib/python3.12/site-packages

COPY --from=api-build /usr/local/bin \
    /usr/local/bin

COPY --from=api-build /app /app

# Web application
COPY --from=web-build /repo/web/.next/standalone \
    /app/web/

COPY --from=web-build /repo/web/.next/static \
    /app/web/.next/static

COPY --from=web-build /repo/web/public \
    /app/web/public

RUN mkdir -p /data \
    && chown -R telagent:telagent /app /data

USER telagent

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0

EXPOSE 10000

CMD ["sh", "/app/render-start.sh"]
